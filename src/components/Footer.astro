---
import { useTranslations, defaultLang, type Lang } from '../i18n/utils';
import { withBase } from '../utils/url';
import { site } from '../data/site';

const lang = (Astro.currentLocale ?? defaultLang) as Lang;
const t = useTranslations(lang);
const year = new Date().getFullYear();
---

<footer class="mt-20 border-t border-slate-200/80 dark:border-white/10">
  <div class="mx-auto flex w-full max-w-6xl flex-col gap-5 px-5 py-8 text-sm text-slate-500 dark:text-slate-400 sm:flex-row sm:items-center sm:justify-between sm:px-6 lg:px-8">
    <div class="flex items-center gap-3">
      <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-slate-900 font-mono text-xs font-bold text-cyan-300 dark:bg-cyan-400 dark:text-slate-950">C_</span>
      <p>&copy; {year} Chefil &middot; {t('footer.rights')}</p>
    </div>
    <div class="flex items-center gap-5">
      {
        site.socials.map((social) => (
          <a href={social.href} class="transition-colors hover:text-cyan-700 dark:hover:text-cyan-300">{social.label}</a>
        ))
      }
      <a href={withBase(`${lang}/blog/rss.xml`)} class="font-mono transition-colors hover:text-cyan-700 dark:hover:text-cyan-300">RSS</a>
    </div>
  </div>
</footer>
