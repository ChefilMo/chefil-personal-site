---
import type { ExperienceItem } from '../data/experience';
import { defaultLang, type Lang } from '../i18n/utils';

interface Props {
  item: ExperienceItem;
}

const { item } = Astro.props;
const lang = (Astro.currentLocale ?? defaultLang) as Lang;
---

<li class="relative border-l-2 border-gray-200 pl-6 pb-8 last:pb-0 dark:border-gray-700">
  <span class="absolute -left-[7px] top-1 h-3 w-3 rounded-full bg-sky-600"></span>
  <p class="text-sm text-gray-500 dark:text-gray-400">{item.period}</p>
  <h3 class="mt-1 text-lg font-semibold">{item.title[lang]}</h3>
  <p class="text-gray-600 dark:text-gray-300">{item.org}</p>
  <p class="mt-2 leading-relaxed text-gray-700 dark:text-gray-200">{item.points[lang]}</p>
</li>
