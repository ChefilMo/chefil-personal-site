---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogCard from '../../components/BlogCard.astro';
import { useTranslations, type Lang } from '../../i18n/utils';
import { getCollection } from 'astro:content';

const lang = Astro.currentLocale as Lang;
const t = useTranslations(lang);

const posts = (await getCollection('blog', ({ data }) => data.lang === lang)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<BaseLayout title={`${t('nav.blog')} · Chefil`} description={t('nav.blog')}>
  <h1 class="text-3xl font-bold tracking-tight">{t('nav.blog')}</h1>
  {
    posts.length > 0 ? (
      <div class="mt-8 flex flex-col gap-4">
        {posts.map((post) => (
          <BlogCard
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            tags={post.data.tags}
            href={`/${lang}/blog/${post.id.split('/').pop()}/`}
          />
        ))}
      </div>
    ) : (
      <p class="mt-8 text-gray-500 dark:text-gray-400">{t('blog.empty')}</p>
    )
  }
</BaseLayout>
