---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogCard from '../../components/BlogCard.astro';
import { useTranslations, defaultLang, type Lang } from '../../i18n/utils';
import { withBase } from '../../utils/url';
import { getCollection } from 'astro:content';
import { seriesNames } from '../../data/series';

const lang = (Astro.currentLocale ?? defaultLang) as Lang;
const t = useTranslations(lang);

const posts = (await getCollection('blog', ({ data }) => data.lang === lang)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

// 当前语言下存在的系列（有序，用于列表页入口）
const seriesIds = [
  ...new Set(posts.map((p) => p.data.series).filter((s): s is string => Boolean(s))),
];
---

<BaseLayout title={`${t('nav.blog')} · Chefil`} description={t('nav.blog')}>
  <h1 class="text-3xl font-bold tracking-tight">{t('nav.blog')}</h1>
  {
    seriesIds.length > 0 && (
      <section class="mt-8" data-reveal>
        <h2 class="text-lg font-semibold text-gray-500 dark:text-gray-400">{t('blog.series')}</h2>
        <ul class="mt-3 flex flex-col gap-2">
          {seriesIds.map((id) => (
            <li>
              <a
                href={withBase(`${lang}/blog/series/${id}/`)}
                class="text-sky-600 transition-colors hover:underline dark:text-sky-400"
              >
                {seriesNames[id]?.[lang] ?? id}
              </a>
              <span class="ml-2 text-sm text-gray-500 dark:text-gray-400">
                {posts.filter((p) => p.data.series === id).length} {t('blog.postCount')}
              </span>
            </li>
          ))}
        </ul>
      </section>
    )
  }
  {
    posts.length > 0 ? (
      <div class="mt-8 flex flex-col gap-4">
        {posts.map((post) => (
          <BlogCard
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            tags={post.data.tags}
            href={withBase(`${lang}/blog/${post.id.split('/').pop()}/`)}
          />
        ))}
      </div>
    ) : (
      <p class="mt-8 text-gray-500 dark:text-gray-400">{t('blog.empty')}</p>
    )
  }
</BaseLayout>
