---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useTranslations, defaultLang, type Lang } from '../../i18n/utils';
import { withBase } from '../../utils/url';
import { getCollection } from 'astro:content';
import { blogCategories, categoryNames } from '../../data/blog-categories';

const lang = (Astro.currentLocale ?? defaultLang) as Lang;
const t = useTranslations(lang);

const allPosts = await getCollection('blog', ({ data }) => data.lang === lang);
---

<BaseLayout title={`${t('nav.blog')} · Chefil`} description={t('nav.blog')}>
  <h1 class="text-3xl font-bold tracking-tight">{t('nav.blog')}</h1>
  <div class="mt-8 grid gap-4 sm:grid-cols-2" data-reveal>
    {
      blogCategories.map((cat) => {
        const count = allPosts.filter((p) => p.data.category === cat.id).length;
        return (
          <a
            href={withBase(`${lang}/blog/category/${cat.id}/`)}
            class="rounded-lg border border-gray-200 p-5 transition-shadow hover:shadow-md dark:border-gray-700"
          >
            <p class="text-2xl">{cat.icon}</p>
            <h2 class="mt-2 text-lg font-semibold">{categoryNames[cat.id][lang]}</h2>
            <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
              {count} {t('blog.postCount')}
            </p>
          </a>
        );
      })
    }
  </div>
</BaseLayout>
