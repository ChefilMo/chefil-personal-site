---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useTranslations, defaultLang, type Lang } from '../../i18n/utils';
import { withBase } from '../../utils/url';
import { site } from '../../data/site';
import ParticleBackground from '../../components/ParticleBackground.astro';
import Terminal from '../../components/Terminal.astro';

const lang = (Astro.currentLocale ?? defaultLang) as Lang;
const t = useTranslations(lang);
---

<BaseLayout title={site.name} description={site.tagline[lang]}>
  <ParticleBackground />

  <section class="py-12" data-reveal>
    <h1 class="text-4xl font-bold tracking-tight">{site.name}</h1>
    <p class="mt-2 text-xl text-gray-600 dark:text-gray-300">{site.title[lang]}</p>
    <p
      id="tagline"
      data-text={site.tagline[lang]}
      aria-label={site.tagline[lang]}
      class="mt-6 min-h-8 max-w-2xl leading-relaxed text-gray-700 dark:text-gray-200"
    >
      {site.tagline[lang]}
    </p>
    <div class="mt-8 flex gap-3">
      <a
        href={withBase(`${lang}/projects/`)}
        class="rounded bg-sky-600 px-4 py-2 text-white transition-colors hover:bg-sky-700"
      >
        {t('home.viewProjects')}
      </a>
      <a
        href={withBase(`${lang}/about/`)}
        class="rounded border border-gray-300 px-4 py-2 transition-colors hover:border-gray-400 dark:border-gray-600"
      >
        {t('home.contactMe')}
      </a>
    </div>
  </section>

  <section class="mt-8" data-reveal>
    <h2 class="text-lg font-semibold text-gray-500 dark:text-gray-400">{t('home.skills')}</h2>
    <ul class="mt-3 flex flex-wrap gap-2">
      {
        site.skills.map((skill) => (
          <li class="rounded-full bg-gray-100 px-3 py-1 text-sm text-gray-700 dark:bg-gray-800 dark:text-gray-200">
            {skill}
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mt-12" data-reveal>
    <h2 class="mb-3 text-lg font-semibold text-gray-500 dark:text-gray-400">
      {lang === 'zh' ? '终端' : 'Terminal'}
    </h2>
    <Terminal lang={lang} />
  </section>

  <script>
    // 打字机效果：用户未偏好减少动画时，逐字输出标语
    const el = document.getElementById('tagline');
    if (el && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const text = el.dataset.text ?? '';
      el.textContent = '';
      let i = 0;
      const cursor = document.createElement('span');
      cursor.textContent = '▍';
      cursor.className = 'text-sky-500';
      el.appendChild(cursor);
      const timer = setInterval(() => {
        if (i < text.length) {
          cursor.before(document.createTextNode(text[i]));
          i++;
        } else {
          cursor.remove();
          clearInterval(timer);
        }
      }, 60);
    }
  </script>
</BaseLayout>
