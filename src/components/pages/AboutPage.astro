---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useTranslations, defaultLang, type Lang } from '../../i18n/utils';
import { site } from '../../data/site';
import { withBase } from '../../utils/url';

const lang = (Astro.currentLocale ?? defaultLang) as Lang;
const t = useTranslations(lang);
---

<BaseLayout title={`${t('about.heading')} · ${site.name}`} description={site.bio[lang]}>
  <section class="grid items-center gap-8 py-8 sm:grid-cols-[1fr_auto]">
    <div>
      <p class="font-mono text-xs font-semibold tracking-[0.18em] text-cyan-700 dark:text-cyan-300">BEHIND THE DEVICES</p>
      <h1 class="mt-3 text-3xl font-bold tracking-tight">{t('about.heading')}</h1>
      <p class="mt-6 max-w-2xl leading-relaxed text-slate-600 dark:text-slate-300">
        {site.bio[lang]}
      </p>
    </div>
    <img
      src={withBase('images/avatar.webp')}
      alt={site.name}
      width="512"
      height="482"
      class="mx-auto w-40 rounded-3xl border border-white/60 shadow-xl shadow-pink-200/20 ring-1 ring-slate-900/5 dark:border-white/10 dark:ring-white/10 sm:w-48"
    />
  </section>

  <section class="mt-8">
    <h2 class="text-lg font-semibold text-gray-500 dark:text-gray-400">{t('about.contact')}</h2>
    <ul class="mt-3 flex flex-wrap gap-3">
      {
        site.socials.map((social) => (
          <li>
            <a
              href={social.href}
              class="rounded border border-gray-300 px-4 py-2 text-sm transition-colors hover:border-gray-400 hover:text-sky-600 dark:border-gray-600 dark:hover:text-sky-400"
            >
              {social.label}
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
