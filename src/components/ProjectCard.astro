---
import type { Project } from '../data/projects';
import { useTranslations, defaultLang, type Lang } from '../i18n/utils';
import { withBase } from '../utils/url';

interface Props {
  project: Project;
  /** 列表序号，用于进场动画的交错延迟 */
  index?: number;
}

const { project, index = 0 } = Astro.props;
const lang = (Astro.currentLocale ?? defaultLang) as Lang;
const t = useTranslations(lang);
---

<article
  class="overflow-hidden rounded-3xl border border-slate-200/80 bg-white/75 shadow-sm transition-all hover:-translate-y-1 hover:border-cyan-300 hover:shadow-xl hover:shadow-cyan-950/5 dark:border-white/10 dark:bg-slate-900/70 dark:hover:border-cyan-700"
  data-reveal
  style={`transition-delay: ${index * 80}ms`}
>
  {
    project.image && (
      <div class="aspect-[16/10] border-b border-slate-100 bg-white dark:border-white/10">
        <img
          src={withBase(project.image)}
          alt={project.name[lang]}
          width="800"
          height="800"
          class="h-full w-full object-contain p-5"
          loading="lazy"
        />
      </div>
    )
  }
  <div class="p-6">
    <p class="font-mono text-xs tracking-widest text-cyan-700 dark:text-cyan-300">PROJECT {String(index + 1).padStart(2, '0')}</p>
    <h2 class="mt-3 text-xl font-semibold tracking-tight">{project.name[lang]}</h2>
    <p class="mt-3 text-sm leading-relaxed text-slate-600 dark:text-slate-400">{project.summary[lang]}</p>
    <ul class="mt-5 flex flex-wrap gap-2">
      {
        project.tags.map((tag) => (
          <li class="rounded-full bg-slate-100 px-3 py-1 font-mono text-xs text-slate-600 dark:bg-white/5 dark:text-slate-300">
            {tag}
          </li>
        ))
      }
    </ul>
    <div class="mt-6 flex flex-wrap gap-x-5 gap-y-2">
      {
        project.links.map((link) => (
          <a href={link.href} class="text-sm font-medium text-cyan-700 transition-colors hover:underline dark:text-cyan-300">
            {link.label} &rarr;
          </a>
        ))
      }
      {
        project.relatedSeries && (
          <a href={withBase(`${lang}/blog/series/${project.relatedSeries}/`)} class="text-sm font-medium text-cyan-700 transition-colors hover:underline dark:text-cyan-300">
            {t('project.relatedSeries')} &rarr;
          </a>
        )
      }
    </div>
  </div>
</article>
