---
import { useTranslations, otherLang, getLocalizedPath, defaultLang, type Lang } from '../i18n/utils';
import { withBase } from '../utils/url';
import ThemeToggle from './ThemeToggle.astro';

const lang = (Astro.currentLocale ?? defaultLang) as Lang;
const t = useTranslations(lang);
const targetLang = otherLang(lang);

const links = [
  { href: withBase(`${lang}/`), key: 'nav.home' },
  { href: withBase(`${lang}/experience/`), key: 'nav.experience' },
  { href: withBase(`${lang}/projects/`), key: 'nav.projects' },
  { href: withBase(`${lang}/blog/`), key: 'nav.blog' },
  { href: withBase(`${lang}/about/`), key: 'nav.about' },
] as const;

const currentPath = Astro.url.pathname.replace(/\/$/, '');
function isActive(href: string, key: string): boolean {
  const path = href.replace(/\/$/, '');
  return currentPath === path || (key !== 'nav.home' && currentPath.startsWith(`${path}/`));
}
---

<nav class="relative flex items-center" aria-label={t('nav.menu')} data-site-nav>
  <div class="hidden items-center gap-1 lg:flex">
    {
      links.map((link) => (
        <a
          href={link.href}
          aria-current={isActive(link.href, link.key) ? 'page' : undefined}
          class:list={[
            'rounded-full px-3 py-2 text-sm transition-colors',
            isActive(link.href, link.key)
              ? 'bg-cyan-500/10 font-medium text-cyan-700 dark:text-cyan-300'
              : 'text-slate-600 hover:bg-slate-900/5 hover:text-slate-950 dark:text-slate-400 dark:hover:bg-white/5 dark:hover:text-white',
          ]}
        >
          {t(link.key)}
        </a>
      ))
    }
  </div>

  <div class="ml-2 flex items-center gap-1 rounded-full border border-slate-200/80 bg-white/70 p-1 shadow-sm dark:border-white/10 dark:bg-white/5 dark:shadow-none">
    <a
      href={getLocalizedPath(Astro.url.pathname, targetLang)}
      hreflang={targetLang}
      lang={targetLang}
      aria-label={t('lang.switch')}
      title={t('lang.switch')}
      class="flex h-8 items-center gap-1.5 rounded-full px-2.5 font-mono text-xs font-semibold text-slate-600 transition-colors hover:bg-slate-900/5 hover:text-cyan-700 dark:text-slate-300 dark:hover:bg-white/10 dark:hover:text-cyan-300"
    >
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" class="h-4 w-4" aria-hidden="true">
        <circle cx="12" cy="12" r="9"></circle>
        <path d="M3 12h18M12 3c2.3 2.5 3.5 5.5 3.5 9s-1.2 6.5-3.5 9c-2.3-2.5-3.5-5.5-3.5-9S9.7 5.5 12 3Z"></path>
      </svg>
      {targetLang === 'en' ? 'EN' : '中'}
    </a>
    <ThemeToggle />
  </div>

  <button
    id="menu-toggle"
    type="button"
    aria-label={t('nav.menu')}
    aria-expanded="false"
    aria-controls="mobile-menu"
    class="ml-2 inline-flex h-10 w-10 items-center justify-center rounded-full border border-slate-200/80 bg-white/70 text-slate-700 shadow-sm transition-colors hover:bg-slate-100 dark:border-white/10 dark:bg-white/5 dark:text-slate-200 dark:hover:bg-white/10 lg:hidden"
  >
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-5 w-5" aria-hidden="true">
      <path d="M4 7h16M4 12h16M4 17h16"></path>
    </svg>
  </button>

  <div id="mobile-menu" hidden class="absolute right-0 top-[calc(100%+0.75rem)] z-50 w-60 rounded-2xl border border-slate-200 bg-white/95 p-2 shadow-xl shadow-slate-950/10 backdrop-blur-xl dark:border-white/10 dark:bg-slate-900/95 dark:shadow-black/30 lg:hidden">
    {
      links.map((link) => (
        <a
          href={link.href}
          aria-current={isActive(link.href, link.key) ? 'page' : undefined}
          class:list={[
            'block rounded-xl px-4 py-3 text-sm transition-colors',
            isActive(link.href, link.key)
              ? 'bg-cyan-500/10 font-medium text-cyan-700 dark:text-cyan-300'
              : 'text-slate-600 hover:bg-slate-100 dark:text-slate-300 dark:hover:bg-white/5',
          ]}
        >
          {t(link.key)}
        </a>
      ))
    }
  </div>
</nav>

<script>
  const nav = document.querySelector('[data-site-nav]');
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');

  if (nav && toggle && menu) {
    const closeMenu = () => {
      menu.hidden = true;
      toggle.setAttribute('aria-expanded', 'false');
    };

    toggle.addEventListener('click', () => {
      const willOpen = menu.hidden;
      menu.hidden = !willOpen;
      toggle.setAttribute('aria-expanded', String(willOpen));
    });

    document.addEventListener('click', (event) => {
      if (!nav.contains(event.target as Node)) closeMenu();
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !menu.hidden) {
        closeMenu();
        toggle.focus();
      }
    });
  }
</script>
