---
import { useTranslations, defaultLang, type Lang } from '../i18n/utils';

const lang = (Astro.currentLocale ?? defaultLang) as Lang;
const t = useTranslations(lang);
---

<button
  id="theme-toggle"
  type="button"
  aria-label={t('theme.toggle')}
  aria-pressed="false"
  title={t('theme.toggle')}
  class="inline-flex h-8 w-8 items-center justify-center rounded-full text-slate-600 transition-colors hover:bg-slate-900/5 hover:text-cyan-700 dark:text-slate-300 dark:hover:bg-white/10 dark:hover:text-cyan-300"
>
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" class="h-4 w-4 dark:hidden" aria-hidden="true">
    <path d="M20 15.2A8.5 8.5 0 0 1 8.8 4 8.5 8.5 0 1 0 20 15.2Z"></path>
  </svg>
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" class="hidden h-4 w-4 dark:block" aria-hidden="true">
    <circle cx="12" cy="12" r="3.5"></circle>
    <path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.65 17.65l1.42 1.42M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.65 6.35l1.42-1.42"></path>
  </svg>
</button>

<script>
  const btn = document.getElementById('theme-toggle');
  const root = document.documentElement;

  function syncState() {
    btn?.setAttribute('aria-pressed', String(root.classList.contains('dark')));
  }

  btn?.addEventListener('click', () => {
    root.classList.toggle('dark');
    localStorage.setItem('theme', root.classList.contains('dark') ? 'dark' : 'light');
    syncState();
  });

  syncState();
</script>
