---
import BlogPostLayout from '../../../layouts/BlogPostLayout.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { withBase } from '../../../utils/url';

// 为每篇文章按其语言生成路由：/zh/blog/hello-world/、/en/blog/hello-world/
export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => {
    const slug = post.id.split('/').pop()!;
    // 查找关联的另一语言版本（translationKey 相同）
    const translation = posts.find(
      (p) =>
        p.data.translationKey &&
        p.data.translationKey === post.data.translationKey &&
        p.data.lang !== post.data.lang,
    );
    return {
      params: { lang: post.data.lang, slug },
      props: { post, translation },
    };
  });
}

interface Props {
  post: CollectionEntry<'blog'>;
  translation?: CollectionEntry<'blog'>;
}

const { post, translation } = Astro.props;
const { Content } = await render(post);

const translationHref = translation
  ? withBase(`${translation.data.lang}/blog/${translation.id.split('/').pop()}/`)
  : undefined;

// 同系列文章按 seriesOrder 排序，生成上下篇导航
const seriesPosts = post.data.series
  ? (
      await getCollection(
        'blog',
        ({ data }) => data.lang === post.data.lang && data.series === post.data.series,
      )
    ).sort((a, b) => (a.data.seriesOrder ?? 0) - (b.data.seriesOrder ?? 0))
  : [];
const seriesIndex = seriesPosts.findIndex((p) => p.id === post.id);
const postHref = (p: CollectionEntry<'blog'>) =>
  withBase(`${p.data.lang}/blog/${p.id.split('/').pop()}/`);
const seriesNav =
  post.data.series && seriesIndex >= 0
    ? {
        series: post.data.series,
        current: seriesIndex + 1,
        total: seriesPosts.length,
        prev: seriesIndex > 0 ? postHref(seriesPosts[seriesIndex - 1]) : undefined,
        next: seriesIndex < seriesPosts.length - 1 ? postHref(seriesPosts[seriesIndex + 1]) : undefined,
      }
    : undefined;
---

<BlogPostLayout
  title={post.data.title}
  description={post.data.description}
  pubDate={post.data.pubDate}
  tags={post.data.tags}
  translationHref={translationHref}
  seriesNav={seriesNav}
>
  <Content />
</BlogPostLayout>
