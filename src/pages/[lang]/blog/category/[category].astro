---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import BlogCard from '../../../../components/BlogCard.astro';
import { useTranslations, defaultLang, type Lang } from '../../../../i18n/utils';
import { withBase } from '../../../../utils/url';
import { getCollection } from 'astro:content';
import { blogCategories, categoryNames, type BlogCategory } from '../../../../data/blog-categories';
import { seriesNames } from '../../../../data/series';

// 每个分类 × 每种语言生成一条路由：/zh/blog/category/embedded/
export function getStaticPaths() {
  return blogCategories.flatMap((cat) => [
    { params: { lang: 'zh', category: cat.id } },
    { params: { lang: 'en', category: cat.id } },
  ]);
}

const { category } = Astro.params;
const lang = (Astro.currentLocale ?? defaultLang) as Lang;
const t = useTranslations(lang);

const cat = category as BlogCategory;
const posts = (
  await getCollection('blog', ({ data }) => data.lang === lang && data.category === cat)
).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// 系列分组：按系列内最小序号排序；不属于系列的归入"独立文章"
const seriesIds = [
  ...new Set(posts.map((p) => p.data.series).filter((s): s is string => Boolean(s))),
].sort(
  (a, b) =>
    Math.min(...posts.filter((p) => p.data.series === a).map((p) => p.data.seriesOrder ?? 0)) -
    Math.min(...posts.filter((p) => p.data.series === b).map((p) => p.data.seriesOrder ?? 0)),
);
const seriesPosts = (id: string) =>
  posts
    .filter((p) => p.data.series === id)
    .sort((a, b) => (a.data.seriesOrder ?? 0) - (b.data.seriesOrder ?? 0));
const standalone = posts.filter((p) => !p.data.series);

const postHref = (p: { data: { lang: string }; id: string }) =>
  withBase(`${p.data.lang}/blog/${p.id.split('/').pop()}/`);
---

<BaseLayout
  title={`${categoryNames[cat][lang]} · Chefil`}
  description={categoryNames[cat][lang]}
>
  <p>
    <a
      href={withBase(`${lang}/blog/`)}
      class="text-sm text-sky-600 hover:underline dark:text-sky-400"
    >
      &larr; {t('blog.backToBlog')}
    </a>
  </p>
  <h1 class="mt-4 text-3xl font-bold tracking-tight">{categoryNames[cat][lang]}</h1>

  {
    posts.length === 0 ? (
      <p class="mt-8 text-gray-500 dark:text-gray-400">{t('blog.categoryEmpty')}</p>
    ) : (
      <div class="mt-8 flex flex-col gap-8">
        {seriesIds.map((id) => (
          <section data-reveal>
            <h2 class="text-lg font-semibold">
              <a
                href={withBase(`${lang}/blog/series/${id}/`)}
                class="text-sky-600 transition-colors hover:underline dark:text-sky-400"
              >
                {t('blog.series')}：{seriesNames[id]?.[lang] ?? id}
              </a>
              <span class="ml-2 text-sm font-normal text-gray-500 dark:text-gray-400">
                {seriesPosts(id).length} {t('blog.postCount')}
              </span>
            </h2>
            <div class="mt-3 flex flex-col gap-4">
              {seriesPosts(id).map((post) => (
                <BlogCard
                  title={post.data.title}
                  description={post.data.description}
                  pubDate={post.data.pubDate}
                  tags={post.data.tags}
                  href={postHref(post)}
                />
              ))}
            </div>
          </section>
        ))}

        {standalone.length > 0 && (
          <section data-reveal>
            <h2 class="text-lg font-semibold text-gray-500 dark:text-gray-400">
              {t('blog.standalone')}
            </h2>
            <div class="mt-3 flex flex-col gap-4">
              {standalone.map((post) => (
                <BlogCard
                  title={post.data.title}
                  description={post.data.description}
                  pubDate={post.data.pubDate}
                  tags={post.data.tags}
                  href={postHref(post)}
                />
              ))}
            </div>
          </section>
        )}
      </div>
    )
  }
</BaseLayout>
