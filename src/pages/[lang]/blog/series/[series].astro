---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import BlogCard from '../../../../components/BlogCard.astro';
import { useTranslations, defaultLang, type Lang } from '../../../../i18n/utils';
import { withBase } from '../../../../utils/url';
import { getCollection } from 'astro:content';
import { seriesNames } from '../../../../data/series';

// 每个系列 × 每种语言生成一条路由：/zh/blog/series/wifi-thermometer/
export async function getStaticPaths() {
  const posts = await getCollection('blog');
  const seriesIds = [...new Set(posts.map((p) => p.data.series).filter((s) => Boolean(s)))];
  return seriesIds.flatMap((series) => [
    { params: { lang: 'zh', series } },
    { params: { lang: 'en', series } },
  ]);
}

const { series } = Astro.params;
const lang = (Astro.currentLocale ?? defaultLang) as Lang;
const t = useTranslations(lang);

const posts = (
  await getCollection('blog', ({ data }) => data.lang === lang && data.series === series)
).sort((a, b) => (a.data.seriesOrder ?? 0) - (b.data.seriesOrder ?? 0));

const seriesName = seriesNames[series!]?.[lang] ?? series!;
---

<BaseLayout title={`${seriesName} · Chefil`} description={seriesName}>
  <p>
    <a
      href={withBase(`${lang}/blog/`)}
      class="text-sm text-sky-600 hover:underline dark:text-sky-400"
    >
      &larr; {t('blog.backToBlog')}
    </a>
  </p>
  <h1 class="mt-4 text-3xl font-bold tracking-tight">{seriesName}</h1>
  <p class="mt-2 text-sm text-gray-500 dark:text-gray-400">
    {t('blog.series')} · {posts.length} {t('blog.postCount')}
  </p>
  <div class="mt-8 flex flex-col gap-4">
    {
      posts.map((post) => (
        <BlogCard
          title={post.data.title}
          description={post.data.description}
          pubDate={post.data.pubDate}
          tags={post.data.tags}
          href={withBase(`${lang}/blog/${post.id.split('/').pop()}/`)}
        />
      ))
    }
  </div>
</BaseLayout>
